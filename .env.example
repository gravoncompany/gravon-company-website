# Copie para .env.local e preencha SOMENTE com dados reais e aprovados.
# Nenhuma integração é ativada enquanto a variável correspondente estiver vazia.

# URL pública definitiva (usada em canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=
# "true" somente na publicação definitiva aprovada. Qualquer outro valor => noindex (demo).
NEXT_PUBLIC_ALLOW_INDEXING=

# WhatsApp comercial, apenas dígitos com DDI+DDD (ex.: 55DDNNNNNNNNN).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# URL pública do relay de leads (Cloudflare Worker em relay/), que repassa ao Zapier.
# A URL do webhook do Zapier NUNCA vai aqui: fica como segredo do Worker (ZAPIER_WEBHOOK_URL).
NEXT_PUBLIC_LEAD_ENDPOINT=
# E-mail comercial exibido no rodapé.
NEXT_PUBLIC_CONTACT_EMAIL=
# Perfil oficial do Instagram (URL completa).
NEXT_PUBLIC_INSTAGRAM_URL=
# Página/landing oficial do Pipeflow.
NEXT_PUBLIC_PIPEFLOW_URL=
# Acesso ao Portal Gravon para clientes.
NEXT_PUBLIC_PORTAL_URL=

# Rastreamento (carregado apenas após consentimento do visitante).
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Atendimento da Gravon IA no chat flutuante: endpoint que recebe POST { messages, page } e responde { reply }.
NEXT_PUBLIC_GRAVON_IA_CHAT_ENDPOINT=
